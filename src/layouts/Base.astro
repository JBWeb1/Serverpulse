---
const { title, description } = Astro.props;
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '');
const isAbout = path.endsWith('/about');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0d1512" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}><span class="dot" aria-hidden="true"></span>ServerPulse</a>
      <nav aria-label="Main">
        <a href={base} aria-current={isAbout ? undefined : 'page'}>Status</a>
        <a href={`${base}about/`} aria-current={isAbout ? 'page' : undefined}>How it's built</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      Built by <a href="https://github.com/JBWeb1">Joshua Bowers</a> with Astro.
      Server data from the public mcsrvstat.us and BattleMetrics APIs.
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1512;
    --panel: #14201b;
    --line: #25382f;
    --text: #e6efe9;
    --muted: #9bb0a5;
    --accent: #4ade80;
    --off: #f87171;
    --wait: #fbbf24;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--panel); padding: 8px 12px; }
  .site-header, main, footer { max-width: 960px; margin: 0 auto; padding: 0 16px; }
  .site-header {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 18px; padding-bottom: 18px;
  }
  .brand {
    display: flex; align-items: center; gap: 8px;
    color: var(--text); font-weight: 700; font-size: 1.1rem; text-decoration: none;
  }
  .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 10px var(--accent);
  }
  nav { display: flex; gap: 16px; }
  nav a { color: var(--muted); text-decoration: none; padding: 4px 0; }
  nav a[aria-current='page'] { color: var(--text); border-bottom: 2px solid var(--accent); }
  h1 { font-size: clamp(1.8rem, 6vw, 2.8rem); line-height: 1.15; margin: 28px 0 10px; }
  h2 { font-size: 1.25rem; margin: 36px 0 12px; }
  .lead { color: var(--muted); max-width: 60ch; margin: 0 0 8px; }
  footer {
    color: var(--muted); font-size: 0.9rem;
    border-top: 1px solid var(--line);
    margin-top: 56px; padding-top: 20px; padding-bottom: 32px;
  }
</style>
