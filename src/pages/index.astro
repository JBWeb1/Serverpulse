---
import Base from '../layouts/Base.astro';
import ServerCard from '../components/ServerCard.astro';
import { servers } from '../data/servers.js';
import { games } from '../data/games.js';
---
<Base
  title="ServerPulse – live game server status"
  description="Check whether a Minecraft, Rust, ARK, DayZ, CS2 or other game server is online, how many players are on it and what it runs. Fast, free and no sign-up."
>
  <h1>Is the server up?</h1>
  <p class="lead">
    Live status for Minecraft, Rust, ARK, DayZ, CS2 and other online game servers:
    online or offline, player count and version or map. Pick a game and type a server to check it.
  </p>

  <form id="lookup" class="lookup">
    <div class="row">
      <div class="field game-field">
        <label for="game">Game</label>
        <select id="game" name="game">
          {games.map((g) => <option value={g.id}>{g.label}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="address">Server address or name</label>
        <input id="address" name="address" type="text" inputmode="url" autocomplete="off"
          placeholder="play.example.net" required />
      </div>
      <button type="submit">Check</button>
    </div>
  </form>
  <div id="results" class="grid" aria-live="polite"></div>

  <h2>Popular servers</h2>
  <div class="grid">
    {servers.map((s) => <ServerCard {...s} />)}
  </div>

  <template id="card-template">
    <ServerCard name="" address="" />
  </template>

  <noscript><p class="lead">Live status needs JavaScript. The rest of this site works without it.</p></noscript>
</Base>

<script>
  import '../scripts/status.js';
</script>

<style>
  .lookup { margin: 24px 0 16px; }
  .lookup label { display: block; font-size: 0.9rem; color: var(--muted); margin-bottom: 6px; }
  .row { display: flex; gap: 8px; align-items: flex-end; }
  .field { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .game-field { flex: 0 0 200px; }
  input, select {
    flex: 1; min-width: 0;
    background: var(--panel); color: var(--text);
    border: 1px solid var(--line); border-radius: 10px;
    padding: 0 14px; height: 48px; font: inherit;
  }
  button {
    background: var(--accent); color: #062312;
    border: 0; border-radius: 10px;
    padding: 0 20px; height: 48px; font: inherit; font-weight: 700; cursor: pointer;
  }
  .grid {
    display: grid; gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  @media (max-width: 560px) {
    .row { flex-wrap: wrap; }
    .game-field { flex: 1 1 100%; }
  }
  #results:not(:empty) { margin-bottom: 8px; }
</style>
